# Database (PostgreSQL)
DATABASE_URL="postgresql://brainrot:brainrot_secret_pass@localhost:5432/brainrot_db?schema=public"
POSTGRES_USER=brainrot
POSTGRES_PASSWORD=brainrot_secret_pass
POSTGRES_DB=brainrot_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=super_secret_jwt_key_brainrot_platform

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER"
NEXT_PUBLIC_BOT_USERNAME="FarmBrainrots_bot"
ADMIN_CHAT_ID="YOUR_ADMIN_TELEGRAM_CHAT_OR_USER_ID"
WEB_APP_URL="https://your-domain.com"

# Server Ports & URLs
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# Roblox Configuration (Cookie for automated trade bot if used, optional)
ROBLOX_COOKIE=""
ROBLOX_VIP_SERVER_LINK="https://www.roblox.com/share?code=your_vip_server_code"
