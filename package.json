{
  "name": "brainrot-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "vercel-build": "cd apps/web && npm install && npm run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @brainrot/database db:generate",
    "db:migrate": "pnpm --filter @brainrot/database db:migrate",
    "db:seed": "pnpm --filter @brainrot/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.15.0"
}
